# Track only the standalone MQTT extension and its public examples.
# Keep the upstream checkout, virtual environments, credentials and artifacts local.
*

!/.gitignore
!/.dockerignore
!/README-MQTT.md
!/README.md
!/requirements-extension.txt

!/mqtt_display/
!/mqtt_display/*.py
!/bootstrap/
!/bootstrap/sitecustomize.py

!/examples/
!/examples/mqtt.yaml
!/examples/mqtt-runtime.yaml
!/examples/cluster-mqtt.yaml
!/examples/cluster-mqtt-runtime.yaml
!/examples/runtime-turzx92.yaml
!/examples/themes/
!/examples/themes/MqttTurzx92/
!/examples/themes/MqttTurzx92/theme.yaml
!/examples/themes/MqttClusterRetro92/
!/examples/themes/MqttClusterRetro92/theme.yaml
!/examples/themes/MqttClusterRetro92/retro-arcade-v1.png
!/examples/themes/MqttClusterRetro92/retro-arcade-v1.prompt.txt

!/docker/
!/docker/README.md
!/docker/Dockerfile.runtime
!/docker/compose.yaml

!/tools/
!/tools/build_cluster_theme.py
!/tools/check_cluster_live.py
!/tools/smoke_editor.py
!/tools/telegraf-parent-net.sh
!/tests/
!/tests/test_extension.py

!/.github/
!/.github/FUNDING.yml
!/.github/workflows/
!/.github/workflows/docker.yml
!/docs/
!/docs/images/
!/docs/images/cluster-retro.gif
!/tools/build_theme_preview.py
